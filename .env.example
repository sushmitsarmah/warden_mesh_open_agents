# RPCs (fill with real endpoints)
SEPOLIA_RPC_URL=
MAINNET_RPC_URL=
OG_RPC_URL=https://evmrpc-testnet.0g.ai

# Explorer / data (fill with real keys)
ETHERSCAN_API_KEY=
GITHUB_TOKEN=
IMMUNEFI_API_KEY=

# LLM (pick your provider — any OpenAI-compatible endpoint works)
# Option 1: OpenAI (default when LLM_BASE_URL not set)
OPENAI_API_KEY=

# Option 2: Anthropic (auto-detected from sk-ant- prefix)
ANTHROPIC_API_KEY=

# Option 3: Custom endpoint (Ollama, vLLM, OpenRouter, Chutes, Gemini, etc.)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=not-needed-for-local
# LLM_MODEL=llama3.2:latest

# Option 4: 0G Compute (decentralized sealed inference)
# See: https://build.0g.ai/compute/#quickstart
#   1. pnpm add -g @0gfoundation/0g-compute-ts-sdk
#   2. 0g-compute-cli setup-network && login && deposit --amount 3
#   3. 0g-compute-cli inference get-secret --provider <PROVIDER>
#   4. Copy the app-sk-... secret and service URL below:
# ZG_SERVICE_URL=https://<provider-address>.0gcompute.ai
# ZG_API_SECRET=app-sk-...
# SEALED_LLM_MODEL=qwen/qwen-2.5-7b-instruct

# The orchestrator routes sensitive tasks (exploit generation, private data)
# to the sealed provider when configured, and falls back to default otherwise.

# Hackathon SDKs
# AXL (Gensyn) - Decentralized mesh network
# Node A (127.0.0.1:9002): Go-based Scout and Orchestrator
# Node B (127.0.0.1:9003): Rust-based Auditor
AXL_API_URL_NODE_A=http://127.0.0.1:9002
AXL_API_URL_NODE_B=http://127.0.0.1:9003

# AXL_PEERS_FOR_NODE_A contains Node B's public key
AXL_PEERS_FOR_NODE_A=
# AXL_PEERS_FOR_NODE_B contains Node A's public key
AXL_PEERS_FOR_NODE_B=

# To configure peers, add the peer's public key (64-char hex).
# For example, after starting Node B, run:
#   curl -s http://127.0.0.1:9003/topology | jq -r '.our_public_key'
# Then set AXL_PEERS_FOR_NODE_A=<node_b_public_key>
# And after starting Node A, run:
#   curl -s http://127.0.0.1:9002/topology | jq -r '.our_public_key'
# Then set AXL_PEERS_FOR_NODE_B=<node_a_public_key>

# KeeperHub - x402 payments (Workflow-based)
KEEPERHUB_API_KEY=
KEEPERHUB_BASE_URL=https://app.keeperhub.com/api
KEEPERHUB_WORKFLOW_ID=
KEEPERHUB_WORKFLOW_ID_2=
KEEPERHUB_WALLET=
REPORT_PRICE_USD=1000
REPORT_SERVER_BASE_URL=http://localhost:8080

# Wallets (testnet only — never commit real keys)
SWARM_PRIVATE_KEY=
OG_PRIVATE_KEY=
ORCHESTRATOR_ADDRESS=

# 0G iNFT (0G Intelligent NFT)
OG_INFT_ADDRESS=0x9756eD45Fe95d53b0d72F5efe2977Df1c876089c

# 0G Storage
STORAGE_GATEWAY_URL=https://storage-turbo-testnet.0g.ai

# 0G SDK integration is opt-in (SDK v1.3.0 can panic on node sync lag).
# To enable real uploads: set OG_STORAGE_USE_SDK=true and fill the rest.
# OG_STORAGE_USE_SDK=true
# OG_STORAGE_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai
# OG_STORAGE_RPC_URL=https://evmrpc-testnet.0g.ai

# Knobs
MIN_DRAIN_THRESHOLD_USD=1000
LLM_MAX_RETRIES=3
DISCLOSURE_WINDOW_DAYS=90
