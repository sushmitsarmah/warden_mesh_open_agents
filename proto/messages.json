{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Target": {
      "type": "object",
      "required": ["id", "kind", "discoveredAt", "priority"],
      "properties": {
        "id": { "type": "string", "description": "uuid v4" },
        "bountyType": { "type": "string", "description": "solidity-evm | firedancer | move-aptos | etc" },
        "kind": { "type": "string", "description": "onchain | github | immunefi | solana-gossip | etc" },
        "chainId": { "type": "integer" },
        "address": { "type": "string" },
        "repo": { "type": "string" },
        "commitSha": { "type": "string" },
        "sourceUrl": { "type": "string" },
        "discoveredAt": { "type": "string", "format": "date-time" },
        "priority": { "type": "number", "minimum": 0, "maximum": 100 },
        "tvlUsd": { "type": "number" }
      }
    },
    "Finding": {
      "type": "object",
      "required": ["id", "targetId", "category", "severity", "tools"],
      "properties": {
        "id": { "type": "string" },
        "targetId": { "type": "string" },
        "bountyType": { "type": "string" },
        "category": { "type": "string" },
        "severity": { "enum": ["info", "low", "medium", "high", "critical"] },
        "tools": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "location": {
          "type": "object",
          "properties": {
            "file": { "type": "string" },
            "lineStart": { "type": "integer" },
            "lineEnd": { "type": "integer" }
          }
        },
        "description": { "type": "string" }
      }
    },
    "VerifiedExploit": {
      "type": "object",
      "required": ["id", "findingId", "pocPath", "impactType", "attackerModel", "verifiedAt"],
      "properties": {
        "id": { "type": "string" },
        "findingId": { "type": "string" },
        "pocPath": { "type": "string", "description": "path to generated PoC file" },
        "impactType": { "type": "string", "description": "crash | bank-hash-mismatch | sandbox-escape | liveness-failure | invalid-block | drain" },
        "validatedAgainstConfig": { "type": "boolean" },
        "attackerModel": { "type": "string", "description": "leader | staked_validator | gossip_participant | remote | etc" },
        "modifiedValidator": { "type": "boolean" },
        "justification": { "type": "string" },
        "verifiedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Disclosure": {
      "type": "object",
      "required": ["id", "exploitId", "lane", "publishedAt"],
      "properties": {
        "id": { "type": "string" },
        "exploitId": { "type": "string" },
        "lane": { "enum": ["bounty", "rescue"] },
        "x402Url": { "type": "string" },
        "txHash": { "type": "string" },
        "storageHash": { "type": "string" },
        "publishedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
